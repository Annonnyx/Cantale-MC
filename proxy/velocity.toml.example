# Exemple Velocity pour Cantale. Ne pas copier par-dessus un velocity.toml déjà déployé.
# Secret : uniquement la variable d'environnement CANTALE_VELOCITY_SECRET.
# La même valeur va dans paper-global.yml (proxies.velocity.secret), hors dépôt.
# Ce fichier ne contient aucun secret. Velocity ne développe pas ${...} tout seul :
# au déploiement, écrire la valeur d'environnement dans forwarding.secret (fichier ignoré de git).

config-version = "2.7"
bind = "0.0.0.0:25565"
motd = "<gold>Cantale"
show-max-players = 500
online-mode = true
force-key-authentication = true
prevent-client-proxy-connections = false
player-info-forwarding-mode = "modern"
forwarding-secret-file = "forwarding.secret"
announce-forge = false

[servers]
# paper-1 écoute en local. Un second nœud s'ajoute ici avec son CANTALE_SERVER_ID.
paper-1 = "127.0.0.1:25566"
try = ["paper-1"]

[forced-hosts]

[advanced]
compression-threshold = 256
login-ratelimit = 3000
connection-timeout = 5000
read-timeout = 30000
haproxy-protocol = false
tcp-fast-open = false
bungee-plugin-message-channel = true
show-ping-requests = false
failover-on-unexpected-server-disconnect = true
announce-proxy-commands = true
log-command-executions = false
log-player-connections = true

[query]
enabled = false
port = 25565
map = "Cantale"
show-plugins = false
